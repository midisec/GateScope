{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.gatescope.local/mcp/manifest.v1.schema.json",
  "title": "GateScope MCP Contract Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transport", "auth_profile", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "transport": {"const": "STREAMABLE_HTTP"},
    "auth_profile": {"const": "SCOPED_SERVICE_TOKEN_V1"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required_scope", "read_only"],
        "properties": {
          "name": {
            "enum": [
              "market_search_instruments",
              "market_get_candles",
              "indicator_get_snapshot",
              "alert_rule_list",
              "signal_list",
              "signal_explain",
              "trade_get_status",
              "trade_get_timeline"
            ]
          },
          "required_scope": {
            "enum": ["market:read", "analysis:read", "alerts:read"]
          },
          "read_only": {"const": true}
        }
      },
      "description": "Callable MCP tools are read-only and additionally scope checked per invocation."
    }
  }
}
