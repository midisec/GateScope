# Copy to .env only for local use. Never commit the populated file.
GATESCOPE_BOOTSTRAP_USERNAME=owner
GATESCOPE_BOOTSTRAP_PASSWORD=
GATESCOPE_PUBLIC_ORIGIN=http://127.0.0.1:8777
GATESCOPE_COOKIE_SECURE=0
GATESCOPE_DB_PATH=data/gate_patterns.db
GATESCOPE_START_WORKERS=false

# Phase 1 PostgreSQL API. Generate each secret independently with 32 random
# bytes and base64url encode it; never reuse these example variable names as values.
GATESCOPE_DATABASE_URL=
GATESCOPE_IDENTITY_KEK=
GATESCOPE_IDENTITY_KEY_VERSION=
GATESCOPE_RECOVERY_PEPPER=
GATESCOPE_CURSOR_SIGNING_KEY=

# Exchange credential admission uses a 3072+ bit RSA envelope key. The API gets
# only the base64url DER public key; only the isolated validator gets the
# matching base64url DER PKCS#8 private key. Never put the private value in the
# gatescope-api environment.
GATESCOPE_CREDENTIAL_WRAP_PUBLIC_KEY=
GATESCOPE_CREDENTIAL_WRAP_PRIVATE_KEY=
GATESCOPE_CREDENTIAL_KEY_VERSION=
GATESCOPE_EXECUTOR_DATABASE_URL=
# The Compose services set these explicitly. TESTNET execution is opt-in via
# `docker compose --profile testnet up`; LIVE_TRADING_ENABLED must remain false.
GATESCOPE_EXECUTOR_WORKLOAD=credential-validation

# MCP runs as a separate, read-only service. In production, use a PostgreSQL
# credential whose role is gatescope_mcp and publish it only behind HTTPS.
GATESCOPE_MCP_DATABASE_URL=
GATESCOPE_MCP_PUBLIC_URL=http://127.0.0.1:8780/mcp

# Dedicated gatescope_paper role. This worker only reads public bars and writes
# simulated trade observations/state; it has no credential or exchange access.
GATESCOPE_PAPER_DATABASE_URL=

# Telegram Bot Token is injected only into notification-worker. The API receives
# only the public bot username plus independent webhook path/header secrets.
GATESCOPE_TELEGRAM_BOT_USERNAME=
GATESCOPE_TELEGRAM_WEBHOOK_ID=
GATESCOPE_TELEGRAM_WEBHOOK_SECRET=
GATESCOPE_TELEGRAM_ALLOWED_USER_IDS=
GATESCOPE_TELEGRAM_BOT_TOKEN=
# Web-configured Telegram secrets use a separate 3072-bit RSA envelope pair.
# API receives only public; notification-worker receives only private.
GATESCOPE_TELEGRAM_WRAP_PUBLIC_KEY=
GATESCOPE_TELEGRAM_WRAP_PRIVATE_KEY=
GATESCOPE_TELEGRAM_KEY_VERSION=

# Independent browser-to-API application-layer envelope. The API requires both
# halves because it decrypts the short-lived request before normal validation.
# This protects request bodies at rest/in passive capture but does not replace TLS.
GATESCOPE_SUBMISSION_WRAP_PUBLIC_KEY=
GATESCOPE_SUBMISSION_WRAP_PRIVATE_KEY=
GATESCOPE_SUBMISSION_KEY_VERSION=

# Phase 0 hard gates. Changing either value makes startup fail.
LIVE_TRADING_ENABLED=false
GATESCOPE_EXECUTION_ENVIRONMENT=PAPER
